{
	"name": "math",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"zod": "^4.5.4",
			"typescript": "^6.0.3",
			"@types/bun": "^1.4.3",
			"varlock": "1.23.0",
			"libsql": "0.5.29",
			"@orpc/server": "^1.15.6",
			"@orpc/openapi": "^1.15.6",
			"@orpc/zod": "^1.15.6",
			"better-auth": "1.7.12",
			"next-themes": "^0.4.6",
			"sonner": "^2.0.8",
			"@orpc/client": "^1.15.6",
			"tailwindcss": "^4.3.3",
			"drizzle-orm": "1.0.0-rc.5"
		}
	},
	"type": "module",
	"varlock": {
		"loadPath": "./apps/server/"
	},
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"check-types": "turbo run check-types",
		"dev:web": "turbo run dev -F web --",
		"dev:server": "turbo run dev -F server --",
		"db:push": "turbo run db:push -F @math/db --",
		"db:studio": "turbo run db:studio -F @math/db --",
		"db:generate": "turbo run db:generate -F @math/db --",
		"db:migrate": "turbo run db:migrate -F @math/db --",
		"env:generate": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"postinstall": "varlock codegen --path ./apps/web/ && varlock codegen --path ./apps/server/ && varlock codegen --path ./packages/db/",
		"auth:generate": "cd apps/server && bun run auth:generate",
		"check": "biome check --write ."
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@math/config": "workspace:*",
		"@types/bun": "catalog:",
		"lefthook": "^2.2.1",
		"turbo": "^2.11.7",
		"typescript": "catalog:",
		"varlock": "catalog:"
	},
	"packageManager": "bun@1.4.0",
	"patchedDependencies": {
		"@libsql/isomorphic-ws@0.1.5": "patches/@libsql%2Fisomorphic-ws@0.1.5.patch"
	}
}
