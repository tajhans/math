{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"bunVersion": "1.x",
	"services": {
		"server": {
			"root": "apps/server",
			"framework": "elysia",
			"entrypoint": "src/index.ts",
			"installCommand": "cd ../.. && bun install",
			"buildCommand": "bun run env:generate && bun run check-types",
			"functions": {
				"src/index.ts": {
					"includeFiles": "{package.json,apps/server/.env.schema,node_modules/.bin/varlock,node_modules/varlock/**}"
				}
			}
		},
		"web": {
			"root": "apps/web",
			"framework": "vite",
			"installCommand": "cd ../.. && bun install"
		}
	},
	"rewrites": [
		{ "source": "/api/(.*)", "destination": { "service": "server" } },
		{ "source": "/rpc/(.*)", "destination": { "service": "server" } },
		{ "source": "/(.*)", "destination": { "service": "web" } }
	]
}
