{
	"$schema": "https://openapi.vercel.sh/vercel.json",
	"services": {
		"server": {
			"root": "apps/server",
			"framework": "elysia"
		},
		"web": {
			"root": "apps/web",
			"framework": "vite"
		}
	},
	"rewrites": [
		{ "source": "/api/(.*)", "destination": { "service": "server" } },
		{ "source": "/rpc/(.*)", "destination": { "service": "server" } },
		{ "source": "/(.*)", "destination": { "service": "web" } }
	]
}
